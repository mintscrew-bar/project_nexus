NODE_ENV=development

APP_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000

POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6379
API_HOST_PORT=4000
WEB_HOST_PORT=3000
UPTIME_KUMA_HOST_PORT=3001

DATABASE_URL=postgresql://nexus:nexus_password@localhost:5432/nexus?schema=public
REDIS_URL=redis://localhost:6379

JWT_ACCESS_SECRET=change-me-openssl-rand-base64-32
JWT_REFRESH_SECRET=change-me-openssl-rand-base64-32
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
NEXTAUTH_SECRET=change-me-openssl-rand-base64-32

DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_GUILD_CALLBACK_URL=http://localhost:4000/api/discord/guild-link/callback
DISCORD_CALLBACK_URL=http://localhost:4000/api/auth/discord/callback
DISCORD_LINK_CALLBACK_URL=http://localhost:4000/api/auth/discord/link/callback
RIOT_API_KEY=

DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
DISCORD_NOTIFICATION_CHANNEL_ID=
ADMIN_ALERT_DISCORD_GUILD_ID=
ADMIN_ALERT_DISCORD_CHANNEL_ID=
ADMIN_ALERT_DISCORD_APPROVAL_CHANNEL_ID=
ADMIN_ALERT_DISCORD_REPORT_CHANNEL_ID=
ADMIN_ALERT_DISCORD_APPEAL_CHANNEL_ID=
ADMIN_ALERT_DISCORD_OPERATION_CHANNEL_ID=
ADMIN_ALERT_DISCORD_SECURITY_CHANNEL_ID=
DISCORD_MEMBER_ROLE_ID=
DISCORD_MEMBER_ROLE_NAME=인증됨
DISCORD_MAIN_LINE_ROLE_PREFIX=주라인-
DISCORD_SUB_LINE_ROLE_PREFIX=부라인-
DISCORD_TIER_ROLE_PREFIX=티어-
DISCORD_LOBBY_CHANNEL_NAME=내전 대기실
DISCORD_CAPTAIN_ROLE_NAME=팀장

RIOT_MATCH_CACHE_CLEANUP_ENABLED=false
RIOT_MATCH_CACHE_TTL_DAYS=14

# Upload storage: local or r2
UPLOAD_DRIVER=local
# Public URL used when UPLOAD_DRIVER=r2, e.g. https://media.example.com
UPLOAD_PUBLIC_BASE_URL=
NEXT_PUBLIC_UPLOADS_BASE_URL=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Optional override. Defaults to https://{R2_ACCOUNT_ID}.r2.cloudflarestorage.com
R2_ENDPOINT=

# 치지직 채널 인증 (OAuth) — developers.chzzk.naver.com 에서 앱 등록 후 발급
# 스코프는 "채널 조회"만 필요하다. 스트림키/방송설정변경 스코프는 요청하지 않는다.
CHZZK_CLIENT_ID=
CHZZK_CLIENT_SECRET=
CHZZK_CALLBACK_URL=https://labs-nexus.com/api/auth/chzzk/callback

# ─────────────────────────────────────────────────────────────────────────────
# 운영 배포 전용 (docker-compose.prod.yml)
#
# 운영 .env.production은 GitHub Secrets에서 배포 워크플로가 생성한다.
# (.github/workflows/deploy.yml) 여기 목록은 어떤 키가 필요한지에 대한 참고용이다.
# ─────────────────────────────────────────────────────────────────────────────

# 배포할 이미지 태그
IMAGE_TAG=

# 프록시(Nginx/Caddy)를 앞에 두는 구성이라 API는 localhost에만 바인딩한다.
API_BIND_HOST=127.0.0.1

# Postgres
POSTGRES_USER=nexus
POSTGRES_PASSWORD=change-me-long-random-password
POSTGRES_DB=nexus

# 민감정보 암호화 키 (32바이트 base64 또는 hex)
DATA_ENCRYPTION_KEY=change-me-32-byte-base64-or-hex
DATA_LOOKUP_HMAC_KEY=change-me-32-byte-base64-or-hex

# Riot 토너먼트 API
RIOT_REGION=kr
RIOT_TOURNAMENT_PROVIDER_ID=
RIOT_TOURNAMENT_ID=
TOURNAMENT_API_ENABLED=false

# Cloudflare Tunnel — 운영 compose가 항상 이 서비스를 띄운다.
# Cloudflare Zero Trust → Networks → Tunnels → Docker 탭에서 발급.
CLOUDFLARE_TUNNEL_TOKEN=
