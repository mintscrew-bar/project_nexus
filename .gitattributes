# 기본: 텍스트 파일은 저장소에 항상 LF로 저장한다.
# (작업 폴더 체크아웃 형태는 아래 eol 지정과 core.autocrlf가 결정)
* text=auto

# ── 소스/설정: 작업 폴더에서도 LF 고정 ──────────────────────────
# Windows/macOS/Linux 혼용 환경에서 줄바꿈만 바뀐 diff가 생기지 않도록
# 팀이 다루는 텍스트 확장자를 모두 명시한다.
*.ts      text eol=lf
*.tsx     text eol=lf
*.js      text eol=lf
*.jsx     text eol=lf
*.mjs     text eol=lf
*.cjs     text eol=lf
*.json    text eol=lf
*.css     text eol=lf
*.scss    text eol=lf
*.html    text eol=lf
*.svg     text eol=lf
*.md      text eol=lf
*.yml     text eol=lf
*.yaml    text eol=lf
*.sql     text eol=lf
*.prisma  text eol=lf
*.conf    text eol=lf
.gitignore     text eol=lf
.gitattributes text eol=lf
.dockerignore  text eol=lf
Dockerfile*    text eol=lf

# 셸 스크립트는 반드시 LF (CRLF면 리눅스에서 실행 불가)
*.sh text eol=lf

# 배치/PowerShell 스크립트는 CRLF 유지
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# ── 바이너리: 줄바꿈 변환·diff 대상에서 제외 ────────────────────
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.webp binary
*.avif binary
*.pdf  binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.otf   binary
*.eot   binary
*.mp4  binary
*.webm binary
*.zip  binary
*.gz   binary

# 락파일은 diff 노이즈가 커서 리뷰에서 접어둔다
pnpm-lock.yaml -diff linguist-generated
